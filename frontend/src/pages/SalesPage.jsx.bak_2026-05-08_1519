      applyIVA: snapshot?.applyIVA ?? true,
      ivaRate: snapshot?.ivaRate ?? effectiveIvaRate,
      applyRetention: snapshot?.applyRetention ?? false,
      retentionRate: snapshot?.retentionRate ?? 2,
      currency: snapshot?.currency || "NIO",
