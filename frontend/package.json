    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "eslint": "^8.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "15.15.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.10",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
