  "scripts": {
    "start": "vite",
    "dev": "vite",
    "prebuild": "node scripts/generate-env.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:draft-check": "node scripts/automated_draft_check.js",
    "playwright:install": "npx playwright install chromium",
    "smoke:go-live": "node scripts/live_go_live_smoke.mjs",
    "smoke:ops": "node scripts/live_ops_pages_check.mjs",
    "test:e2e:ops": "cross-env FRONTEND_BASE=http://127.0.0.1:3000 BASE_URL=http://127.0.0.1:3000 BACKEND_BASE=http://127.0.0.1:8001 BACKEND_URL=http://127.0.0.1:8001 playwright test e2e/ops_purge_controls.spec.js e2e/attendance_semaphore.spec.js --workers=1 --reporter=list",
    "test:post-publish-extended": "cross-env FRONTEND_BASE=http://127.0.0.1:3000 BASE_URL=http://127.0.0.1:3000 BACKEND_BASE=http://127.0.0.1:8001 BACKEND_URL=http://127.0.0.1:8001 playwright test e2e/login.spec.js e2e/create_customer.spec.js e2e/kiosk_ui_smoke.spec.js e2e/login_ui_interaction.spec.js e2e/capture_login_console.spec.js tests/pin_login.spec.js --workers=1 --reporter=list",
    "test:erp-full": "node scripts/run_full_erp_suite.mjs",
    "test:erp-full:api": "node scripts/run_full_erp_suite.mjs --only=seed,api",
    "test:erp-full:ui": "node scripts/run_full_erp_suite.mjs --only=seed,ui",
    "test:erp-full:chaos": "node scripts/run_full_erp_suite.mjs --only=seed,chaos",
    "test:fulfillment": "node scripts/live_fulfillment_step2.mjs",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "electron:build": "electron-builder",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:android": "npm run cap:sync && npx cap open android"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.mclarens.erp",
    "productName": "MC-LARENS ERP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "public/**/*",
      "capacitor.config.ts"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon-192.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@eslint/js": "9.23.0",
