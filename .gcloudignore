# ==============================================================================
# MC-LARENS ERP: .gcloudignore
# ==============================================================================
.gcloudignore
.git
.gitignore
.agents/
.gemini/
scratch/
*.log
node_modules/
**/node_modules/
frontend/node_modules/
backend/__pycache__/
**/__pycache__/
*.pyc

# Excluir directorios pesados de planos, modelos 3D y videos (se sirven vía Google Cloud Storage CDN Bucket)
backend/data/blueprints_raw/
backend/data/blueprints_cleaned/
frontend/public/vehicles/models/
frontend/public/vehicles/blueprints/
frontend/public/videos/
frontend/public/uploads/
uploads/
temporary_cleanup_validation/
backups/

# Archivos pesados y volcados de depuración
*.zip
*.pdf
*.eps
*.ai
*.mp4
*.xlsx
/vehicle_catalog_export.html
/ERP_TREE.txt
/FRONTEND_TREE.txt
/server.txt
/committed_server_snip.txt

# Excluir builds locales para no duplicar en subida
frontend/build/
frontend/dist/
build/
dist/

# Excluir carpetas pesadas de inspección
scripts/incoming_grok/
scripts/migration/

# GARANTIZAR INCLUSIÓN DE ARCHIVOS ESENCIALES
!frontend/index.html
!backend/requirements.txt
!frontend/scripts/
!backend/scripts/

