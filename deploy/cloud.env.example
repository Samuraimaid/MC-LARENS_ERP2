# ==============================================================================
# MC-LARENS ERP 2.0 - Variables de Entorno para Despliegue en la Nube (1 Sucursal)
# ==============================================================================
# Copia este archivo como .env en tu servidor en la nube / Cloud Run
# ==============================================================================

# Identidad y Sucursal (Sucursal Central: Mundo de Accesorios)
BRANCH_ID=branch_main
DEFAULT_BRANCH_ID=branch_main
NODE_ID=branch_main
NODE_NAME=Mundo de Accesorios - Central
NODE_TYPE=CENTRAL
NODE_ENABLE_SALES=true
NODE_ENABLE_WORKSHOP=true
NODE_ENABLE_HR=true

# Base de Datos MongoDB Gestionada (MongoDB Atlas en GCP)
# Reemplaza <USER>, <PASSWORD> y <CLUSTER> con las credenciales de tu MongoDB Atlas en Google Cloud
MONGODB_LOCAL_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/mc-larens2_mundo_accesorios_erp?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/mc-larens2_mundo_accesorios_erp?retryWrites=true&w=majority
DB_NAME=mc-larens2_mundo_accesorios_erp

# Seguridad y Sesiones
COOKIE_SECURE=true
ALLOW_RRHH_PIN_MANAGEMENT=false
ENABLE_TEST_ENDPOINTS=false
ENABLE_TEST_PIN_SEEDING=false
AUTOLOAD_CORE_SEED=true

# Usuario Administrador / Semilla
DEFAULT_PIN_USER_EMAIL=admin@mclarenerp.com
DEFAULT_PIN_USER_PIN=0101
DEFAULT_LOGIN_PIN_USER_PIN=01011990

# Dominio y CORS (Permitir tu dominio de producción y accesos HTTPS)
# Ejemplo: https://erp.tu-dominio.com o https://mundo-backend-xyz.a.run.app
CORS_ORIGINS=https://localhost:3443,https://127.0.0.1:3443
CORS_ORIGIN_REGEX=https?://(?:localhost|127\.0\.0\.1|.*\.run\.app|.*\.mclarenerp\.com)(?::\d+)?$

# URLs Públicas de Acceso
PUBLIC_TUNNEL_URL_MAIN=https://erp.mclarenerp.com
CLOUD_FRONTEND_URL=https://erp.mclarenerp.com

# Pines de Acceso Especial (Kiosco Asistencia)
VITE_ATTENDANCE_KIOSK_SHORTCUT_PIN=50005000

# Integración Google Cloud & Google Drive (Almacenamiento de 5 TB)
# Coloca aquí la ruta a las credenciales JSON de la cuenta de servicio de Google o ID de carpeta
GOOGLE_APPLICATION_CREDENTIALS=/app/backend/data/google-service-account.json
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_ENABLED=true

# Integración de Pagos y Notificaciones (Opcionales)
STRIPE_API_KEY=
SENDGRID_API_KEY=
